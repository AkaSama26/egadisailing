{
  "name": "egadisealing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "brevo:smoke": "tsx scripts/brevo-smoke-test.ts",
    "telegram:smoke": "tsx scripts/telegram-smoke-test.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy:prod:app": "bash scripts/deploy-prod-app.sh",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "seo:audit": "node scripts/seo-audit.mjs",
    "cf:purge": "bash scripts/cloudflare-purge-cache.sh",
    "cf:purge:dry-run": "bash scripts/cloudflare-purge-cache.sh --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@next/third-parties": "^16.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.66.0",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@zxing/browser": "^0.1.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.1",
    "framer-motion": "^12.38.0",
    "imapflow": "^1.4.7",
    "ioredis": "^5.10.1",
    "libphonenumber-js": "^1.12.42",
    "lucide-react": "^1.8.0",
    "mailparser": "^3.9.14",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.mts"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@sentry/cli": false,
    "@swc/core": false,
    "esbuild": false,
    "fsevents": false,
    "msgpackr-extract": false,
    "msw": false,
    "sharp": false,
    "unrs-resolver": false,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "ioredis-mock": "^8.13.1",
    "msw": "^2.13.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@swc/helpers": "0.5.17",
    "deepmerge-ts": "8.0.1",
    "hono": "4.13.1",
    "postcss": "8.5.26",
    "tmp": "0.2.7"
  }
}
